# Copy to .env. Everything here is optional.
# ARANGO_URL=http://127.0.0.1:8535
# ARANGO_PASSWORD=cookbook-local-only

# Claude API (tickets, chapter 2). Recommended: sign in once with `ant auth login`
# and leave the line below commented out; the SDK uses your sign-in.
# Only if you use an API key instead: uncomment and fill it in. If this variable is
# set, even to an empty value, it is used instead of your sign-in.
# ANTHROPIC_API_KEY=
